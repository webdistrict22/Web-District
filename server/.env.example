# Runtime
NODE_ENV=production
PORT=5000
MONGO_URI=

# Authentication (generate independent random values of at least 32 characters)
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_DAYS=30

# Frontend and exact CORS/origin allowlist
CLIENT_URL=https://www.web-district.com
ALLOWED_ORIGINS=https://www.web-district.com,https://web-district.com

# Business scheduling
BUSINESS_TIMEZONE=Africa/Cairo
BOOKING_WINDOW_DAYS=7
SLOT_MAINTENANCE_INTERVAL_MS=900000

# Durable email outbox encryption and worker
OUTBOX_ENCRYPTION_KEY=
EMAIL_OUTBOX_ENABLED=true
EMAIL_OUTBOX_POLL_MS=5000
EMAIL_OUTBOX_LEASE_MS=60000
EMAIL_OUTBOX_BATCH_SIZE=10

# Gmail SMTP (degraded readiness is reported if omitted)
EMAIL_USER=
EMAIL_PASS=
OWNER_EMAIL=web.district22@gmail.com
EMAIL_FROM_NAME=Web District
EMAIL_ALLOW_SELF_SIGNED=false

# Cloudinary (degraded readiness is reported if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed-only; remove after intentional use. Password must be at least 12 characters.
ADMIN_FULL_NAME=Web District Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Maintenance scripts are dry-run by default. Set only for an approved apply run.
ALLOW_MAINTENANCE_APPLY=NO
MONGO_TEST_URI=

# Legacy QA harness. Keep all production write/email flags false by default.
API_BASE_URL=http://localhost:5000/api
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_SEND_TEST_EMAIL=false
QA_TEST_EMAIL=
QA_RUN_WRITE_TESTS=false
QA_ALLOW_PRODUCTION_WRITES=false
